# Copia este fichero como .env
#
# Desarrollo (SQLite, sin instalar nada):
DATABASE_URL="file:./dev.db"
#
# Producción (PostgreSQL). Requiere cambiar también el provider del
# datasource en prisma/schema.prisma a "postgresql":
# DATABASE_URL="postgresql://usuario:clave@host:5432/estribor?schema=public"

# URL pública del sitio. De aquí salen el canonical, el hreflang, el sitemap y
# el JSON-LD. En producción DEBE ser el dominio real: publicar apuntando a
# localhost deja el sitio entero sin indexar y no da ninguna señal, porque la
# web se ve perfecta. El build se niega a compilar en un despliegue si esta
# variable falta o apunta a localhost.
NEXT_PUBLIC_URL="http://localhost:3050"

# Autenticación real del panel /admin. Estas variables solo las usa
# `prisma/seed-admin.ts` para crear el usuario inicial (idempotente).
ADMIN_EMAIL="admin@estribor.es"
ADMIN_PASSWORD="cambia-esta-contrasena"
ADMIN_NOMBRE="Estribor"

# Armador de demostración (solo lo usa prisma/seed-armador.ts).
ARMADOR_EMAIL="armador@estribor.es"
ARMADOR_PASSWORD="Armador2026!"
ARMADOR_NOMBRE="Armador Demo"
ARMADOR_PROPIETARIO="Náutica Llevant"

# Pagos con Stripe. Sin estas variables los pagos quedan desactivados y la
# reserva funciona como petición. Claves de TEST mientras se valida.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Precio de la suscripción Pro en Stripe (id "price_..."). Sin él, la
# suscripción queda desactivada.
STRIPE_PRECIO_PRO="price_..."

# Correo transaccional con Resend. Sin estas variables no se envían correos
# y la reserva sigue funcionando igual.
RESEND_API_KEY="re_..."
EMAIL_DE="Estribor <reservas@estribor.es>"
EMAIL_ADMIN="hola@estribor.es"
