# Copia este fichero como .env
#
# Desarrollo (SQLite, sin instalar nada):
DATABASE_URL="file:./dev.db"
#
# Producción (PostgreSQL). Requiere cambiar también el provider del
# datasource en prisma/schema.prisma a "postgresql":
# DATABASE_URL="postgresql://usuario:clave@host:5432/barlovento?schema=public"

# URL pública del sitio. Se usa en canonical, sitemap, JSON-LD y Open Graph.
NEXT_PUBLIC_URL="http://localhost:3000"
