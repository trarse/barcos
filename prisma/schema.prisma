// Esquema de Estribor.
//
// En desarrollo corre sobre SQLite para que la aplicación funcione sin montar
// nada. Para producción basta cambiar el provider a "postgresql": el esquema
// evita a propósito los tipos nativos de Postgres (arrays, enums) para que la
// migración sea un cambio de una línea.
//
// Todos los importes se guardan en CÉNTIMOS como enteros. Nunca en coma
// flotante: el dinero no se redondea dos veces.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Desde Prisma 7 la URL no vive aquí: la CLI la lee de prisma.config.ts y el
// cliente se conecta a través del driver adapter (src/lib/db.ts).
datasource db {
  provider = "postgresql"
}

/// Zona de navegación: una isla, una costa o una ciudad portuaria.
model Destino {
  id            String  @id @default(cuid())
  slug          String  @unique
  nombre        String
  provincia     String
  comunidad     String
  /// "isla" | "costa" | "ciudad"
  clase         String
  titular       String
  descripcion   String
  /// Traducciones de la descripcion corta. Alimentan el meta description,
  /// que es el texto que se ve en el resultado de busqueda: servirlo en
  /// otro idioma es tirar el clic.
  descripcionEn String?
  descripcionDe String?
  /// Texto largo de la landing, en Markdown ligero. Es lo que posiciona.
  contenido     String
  contenidoEn   String?
  contenidoDe   String?
  /// Idioma en el que estan escritos `contenido` y las `preguntas`. No se
  /// traduce nada automaticamente: si no coincide con el idioma de la
  /// pagina, esos bloques no se pintan ni se marcan en JSON-LD.
  idiomaProsa   String  @default("es")
  /// Texto propio de la landing "sin licencia" de este municipio. Si esta
  /// vacio, la pagina existe pero no se indexa: sin texto propio seria una
  /// pagina mas del monton, que es justo lo que hunde a un marketplace.
  sinLicencia   String?
  sinLicenciaEn String?
  sinLicenciaDe String?
  latitud       Float
  longitud      Float
  imagen        String
  /// Meses de temporada alta, separados por comas: "6,7,8,9"
  mesesAlta     String  @default("7,8")
  destacado     Boolean @default(false)
  orden         Int     @default(100)

  puertos   Puerto[]
  preguntas Pregunta[]
  accesos   LugarDesde[]

  @@index([destacado, orden])
}

/// Puerto o marina concreta donde se entrega el barco.
model Puerto {
  id        String @id @default(cuid())
  slug      String @unique
  nombre    String
  latitud   Float
  longitud  Float
  destinoId String

  destino Destino @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  barcos  Barco[]

  @@index([destinoId])
}

/// Categoría de embarcación: velero, catamarán, lancha...
model TipoBarco {
  id          String  @id @default(cuid())
  slug        String  @unique
  nombre      String
  plural      String
  descripcion String
  /// Si la categoría se puede gobernar sin titulación náutica.
  sinLicencia Boolean @default(false)
  orden       Int     @default(100)

  barcos Barco[]
}

/// Elemento de equipamiento a bordo. Relación N:M implícita con Barco.
model Equipamiento {
  id     String @id @default(cuid())
  slug   String @unique
  nombre String
  /// "navegacion" | "confort" | "ocio" | "seguridad"
  grupo  String

  barcos Barco[]
}

/// Actividad vendida como producto propio: pesca, atardecer, buceo...
model Experiencia {
  id            String  @id @default(cuid())
  slug          String  @unique
  nombre        String
  titular       String
  descripcion   String
  /// Traducciones de la descripcion corta. Alimentan el meta description,
  /// que es el texto que se ve en el resultado de busqueda: servirlo en
  /// otro idioma es tirar el clic.
  descripcionEn String?
  descripcionDe String?
  contenido     String
  contenidoEn   String?
  contenidoDe   String?
  titularEn     String?
  titularDe     String?
  /// Idioma en el que estan escritos `contenido` y las `preguntas`.
  idiomaProsa   String  @default("es")
  imagen        String
  /// Duración típica en horas, para estimar el consumo.
  horas         Int     @default(4)
  orden         Int     @default(100)

  barcos    Barco[]
  preguntas Pregunta[]
}

/// Quien publica el barco: un particular o una empresa de chárter.
model Propietario {
  id             String   @id @default(cuid())
  nombre         String
  /// "particular" | "empresa"
  clase          String   @default("particular")
  desde          DateTime @default(now())
  respondeEnMin  Int      @default(60)
  superAnfitrion Boolean  @default(false)
  avatar         String?
  /// Login del armador, si tiene acceso al área propia.
  usuarioId      String?  @unique
  usuario        Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  barcos Barco[]
}

model Barco {
  id          String @id @default(cuid())
  slug        String @unique
  nombre      String
  fabricante  String
  modelo      String
  anio        Int
  descripcion String
  /// Idioma en el que esta escrita `descripcion`. En otro idioma no se
  /// pinta ni entra en el JSON-LD: una descripcion en castellano dentro de
  /// un Product declarado en ingles es una senal de idioma equivocada.
  idiomaProsa String @default("es")

  // Ficha técnica
  esloraCm   Int
  capacidad  Int
  camarotes  Int @default(0)
  aseos      Int @default(0)
  potenciaCv Int @default(0)

  // Tarifa. Todo en céntimos de euro.
  precioBaseDia     Int
  limpieza          Int   @default(0)
  tasaPortuariaDia  Int   @default(0)
  patronDia         Int?
  fianza            Int   @default(0)
  /// Consumo medio en litros por hora de navegación.
  consumoLitrosHora Float @default(0)
  /// Descuento porcentual a partir de 7 días (0-100).
  descuentoSemana   Int   @default(0)

  // Condiciones
  requiereTitulacion Boolean @default(true)
  reservaInstantanea Boolean @default(false)
  minimoDias         Int     @default(1)

  // Reputación
  valoracion   Float @default(0)
  numOpiniones Int   @default(0)

  publicado Boolean  @default(true)
  creadoEn  DateTime @default(now())

  tipoId        String
  puertoId      String
  propietarioId String

  tipo         TipoBarco      @relation(fields: [tipoId], references: [id])
  puerto       Puerto         @relation(fields: [puertoId], references: [id], onDelete: Cascade)
  propietario  Propietario    @relation(fields: [propietarioId], references: [id], onDelete: Cascade)
  imagenes     Imagen[]
  equipamiento Equipamiento[]
  experiencias Experiencia[]
  opiniones    Opinion[]
  reservas     Reserva[]

  @@index([tipoId])
  @@index([puertoId])
  @@index([publicado, precioBaseDia])
}

model Imagen {
  id      String @id @default(cuid())
  url     String
  alt     String
  orden   Int    @default(0)
  barcoId String

  barco Barco @relation(fields: [barcoId], references: [id], onDelete: Cascade)

  @@index([barcoId, orden])
}

model Opinion {
  id      String   @id @default(cuid())
  autor   String
  nota    Int
  texto   String
  fecha   DateTime @default(now())
  barcoId String

  barco Barco @relation(fields: [barcoId], references: [id], onDelete: Cascade)

  @@index([barcoId])
}

/// Sitio con nombre propio al que se va en barco: una isla, un peñon, una
/// cueva. No es un municipio con puerto, es el motivo por el que se sale.
///
/// Es el hueco mas grande del sector: los agregadores tienen pagina de
/// ciudad pero ninguna de destino, y "tabarca en barco" se busca mas que
/// media provincia junta.
model Lugar {
  id            String  @id @default(cuid())
  slug          String  @unique
  nombre        String
  provincia     String
  titular       String
  /// El title de la pagina, que es el elemento que mas pesa. Traducido a
  /// mano: componerlo con una formula perderia el matiz de cada sitio.
  titularEn     String?
  titularDe     String?
  descripcion   String
  descripcionEn String?
  descripcionDe String?
  /// Texto largo de la pagina. Sin el, la pagina existe pero no se indexa.
  contenido     String
  contenidoEn   String?
  contenidoDe   String?
  /// Idioma en el que estan escritos `contenido` y sus preguntas.
  idiomaProsa   String  @default("es")
  latitud       Float
  longitud      Float
  imagen        String
  /// "isla" | "cabo" | "cala" | "cueva"
  clase         String  @default("cala")
  orden         Int     @default(100)

  accesos   LugarDesde[]
  preguntas Pregunta[]
}

/// Desde que puerto se llega a un lugar y cuanto se tarda. Es lo que
/// convierte una pagina de destino en una pagina que vende: enlaza el
/// sitio que la gente busca con la landing que tiene los barcos.
model LugarDesde {
  id        String  @id @default(cuid())
  lugarId   String
  destinoId String
  /// Tiempo de navegacion aproximado, en minutos.
  minutos   Int
  /// Si se puede llegar con una embarcacion de las que no exigen titulacion.
  sinTitulo Boolean @default(false)

  lugar   Lugar   @relation(fields: [lugarId], references: [id], onDelete: Cascade)
  destino Destino @relation(fields: [destinoId], references: [id], onDelete: Cascade)

  @@unique([lugarId, destinoId])
  @@index([destinoId])
}

/// Pregunta frecuente. Alimenta el bloque de FAQ y su JSON-LD, que es
/// la mitad de lo que hace destacar una landing en resultados.
model Pregunta {
  id        String @id @default(cuid())
  pregunta  String
  respuesta String
  preguntaEn   String?
  respuestaEn  String?
  preguntaDe   String?
  respuestaDe  String?
  orden     Int    @default(0)
  /// A que landing pertenece esta pregunta: "destino" o "sinLicencia".
  bloque    String @default("destino")

  destinoId     String?
  experienciaId String?
  lugarId       String?

  destino     Destino?     @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  experiencia Experiencia? @relation(fields: [experienciaId], references: [id], onDelete: Cascade)
  lugar       Lugar?       @relation(fields: [lugarId], references: [id], onDelete: Cascade)

  @@index([destinoId])
  @@index([experienciaId])
  @@index([lugarId])
}

/// Suscripción de captación. Es la señal del go/no-go que no da Search Console:
/// correos de clientes y de armadores, con su puerto y su página de origen.
model Suscripcion {
  id           String   @id @default(cuid())
  correo       String
  /// "puerto" | "normativa" | "armador"
  variante     String
  /// Puerto o municipio, para la variante "puerto".
  destino      String?
  idioma       String   @default("es")
  paginaOrigen String?
  fecha        DateTime @default(now())
  /// Doble opt-in pendiente de un proveedor de email transaccional.
  confirmado   Boolean  @default(false)

  @@index([variante, fecha])
  @@index([correo])
}

/// Reserva de un barco por un cliente. El precio se guarda en CÉNTIMOS,
/// calculado con el motor de precios de Estribor.
model Reserva {
  id               String   @id @default(cuid())
  /// Referencia legible para el armador y el cliente: "RES-XXXXXX".
  referencia       String   @unique
  barcoId          String
  barco            Barco    @relation(fields: [barcoId], references: [id], onDelete: Cascade)
  fechaInicio      DateTime
  fechaFin         DateTime
  numDias          Int
  numPersonas      Int      @default(1)
  clienteNombre    String
  clienteEmail     String
  clienteTelefono  String?
  /// Total en céntimos de euro.
  precioTotalCents Int
  /// "pendiente" | "confirmada" | "cancelada" | "rechazada" | "completada"
  estado           String   @default("pendiente")
  notas            String?
  idioma           String   @default("es")
  paginaOrigen     String?
  /// Sesión de pago de Stripe (Checkout), si se inició un cobro.
  stripeSessionId  String?  @unique
  /// True cuando Stripe confirma el cobro por webhook.
  pagado           Boolean  @default(false)
  pagadoEn         DateTime?
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  @@index([barcoId, fechaInicio])
  @@index([estado, creadoEn])
}

/// Artículo del blog. Contenido editorial gestionado desde el panel /admin.
/// El SEO depende de estos campos: título, entradilla (meta description), slug
/// y la programación de publicación.
model Articulo {
  id            String    @id @default(cuid())
  /// "es" | "en" | "de"
  idioma        String
  slug          String
  /// <title> de la página.
  titulo        String
  /// Meta description y entradilla visible en las listas.
  entradilla    String
  /// Fecha visible y datePublished del JSON-LD.
  fecha         DateTime
  minutos       Int       @default(5)
  /// "Precios" | "Normativa" | "Rutas" | "Medio ambiente"
  categoria     String
  /// Cuerpo en Markdown ligero.
  cuerpo        String
  /// Enlaces internos al final, como JSON: [{ "texto": "...", "pagina": {...} }]
  relacionados  Json?
  /// Despublicar sin borrar.
  publicado     Boolean   @default(true)
  /// Programación: no es público hasta esta fecha. Null = sin programar.
  publicaDesde  DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  @@unique([idioma, slug])
  @@index([idioma, fecha])
  @@index([publicado, publicaDesde])
}

/// Usuario del panel con autenticación por contraseña.
model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  nombre       String
  /// "sal:hash" generado con scrypt.
  passwordHash String
  /// "admin" o "armador".
  rol          String   @default("admin")
  creadoEn     DateTime @default(now())
  sesiones     Sesion[]
  propietario  Propietario?
}

/// Sesión de un usuario: el token viaja en una cookie httpOnly y aquí se
/// guarda solo su hash SHA-256, para que una fuga de la tabla no permita
/// suplantar la identidad.
model Sesion {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  creadoEn  DateTime @default(now())
  expiraEn  DateTime

  @@index([usuarioId])
  @@index([expiraEn])
}
